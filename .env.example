# Шаблон локальных настроек. Скопировать в .env и поправить под себя.
#
# ВНИМАНИЕ: всё, что начинается с VITE_, ВШИВАЕТСЯ В БАНДЛ и видно в исходниках
# страницы у любого посетителя. Секретам здесь не место — только адреса.

# Куда dev-сервер проксирует /api, /media и /girl-history/.
# По умолчанию локальный бэкенд. 127.0.0.1, а не localhost: бэкенд слушает 127.0.0.1,
# а localhost на этой машине резолвится в ::1, где loopback закрыт.
VITE_API_TARGET=http://127.0.0.1:3001

# Целиться в прод вместо локального бэкенда:
# VITE_API_TARGET=https://95.163.176.94.nip.io

# Базовый путь API, который фронт подставляет в запросы.
# Дев: /api — dev-сервер снимает префикс и отдаёт бэкенду чистый маршрут.
# Прод: /girl-history — так API виден снаружи (подставляется в workflow при сборке).
VITE_API_BASE=/api
